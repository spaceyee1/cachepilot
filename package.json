{
  "name": "cachepilot",
  "description": "Host-neutral MCP plugin for explicit API calls, local cache reuse and usage monitoring.",
  "version": "0.1.2-semantic.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "start": "node scripts/api-mcp.mjs",
    "mcp:config": "node scripts/mcp-config.mjs",
    "test": "node --import ./tests/offline-guard.mjs --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "license": "Apache-2.0",
  "cachepilot": {
    "integration": "mcp-stdio",
    "entry": "scripts/api-mcp.mjs",
    "icon": "assets/icon.svg",
    "supportedPlatform": "win32",
    "hostSpecificManifestRequired": false
  }
}
