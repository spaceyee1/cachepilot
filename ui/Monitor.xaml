<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CachePilot · 通用 API 0.1.1-ui.9 候选监控（未安装）" Width="440" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="True" Opacity="0.92" FontFamily="Microsoft YaHei UI" Foreground="#E5EDF7">
 <Border CornerRadius="17" Background="#F5192332" BorderBrush="#535E7895" BorderThickness="1" Padding="15,10">
  <ScrollViewer x:Name="MainScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" MaxHeight="500">
  <StackPanel>
   <Grid x:Name="DragArea" Height="30" Background="Transparent"><TextBlock Text="◈  CachePilot" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="FoldButton" Content="▴" Width="28" Height="28" Foreground="#B7C8DB" Background="Transparent" BorderThickness="0" FontSize="18" ToolTip="折叠：保留命中率、Token 与实时趋势"/><Button x:Name="CloseButton" Content="×" Width="28" Height="28" Foreground="#B7C8DB" Background="Transparent" BorderThickness="0" FontSize="21" ToolTip="关闭监控框，插件继续运行"/></StackPanel></Grid>
   <TextBlock x:Name="WindowIdentity" Text="候选 UI 0.1.1-ui.9 · 窗口 PID 待核对 · 未安装" FontSize="9" Foreground="#92A6BF"/>
   <TextBlock x:Name="Connection" Text="● 暂无有效数据" Foreground="#E8BD74" FontSize="11" Margin="0,5"/>
   <Border Background="#402B4159" CornerRadius="10" Padding="12,8" Margin="0,4,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="进程累计本地命中率" FontSize="11" Foreground="#A6B7CA"/><TextBlock x:Name="LocalRate" Text="无数据" FontSize="26" FontWeight="SemiBold" Foreground="#7CE3C7" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock x:Name="TokenCaption" Text="最近分词 Token（本地）" FontSize="11" Foreground="#A6B7CA"/><TextBlock x:Name="LastTokens" Text="暂无数据" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></StackPanel>
   </Grid></Border>
   <Grid Margin="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#302B4159" BorderBrush="#2F506C86" BorderThickness="1" CornerRadius="9" Padding="8,6">
     <StackPanel>
      <Grid Margin="0,0,0,3"><TextBlock x:Name="TokenChartTitle" Text="近 120 秒本地 Token" FontSize="10" Foreground="#CAD9EC"/><Border HorizontalAlignment="Right" Background="#2D90BDF4" CornerRadius="3" Padding="4,0"><TextBlock x:Name="ChartTokenKind" Text="估算" FontSize="9" Foreground="#A7CEFF"/></Border></Grid>
      <TextBlock x:Name="WindowTokenValue" Text="等待起点" FontSize="15" Foreground="#91C1FF" Margin="0,0,0,4"/>
      <Grid Height="64"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid x:Name="TokenAxis"><TextBlock x:Name="TokenScale" Text="—" FontSize="9" Foreground="#88A2C0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/><TextBlock Text="0" FontSize="9" Foreground="#88A2C0" VerticalAlignment="Bottom"/></Grid>
       <Grid Grid.Column="1" ClipToBounds="True">
        <Grid IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Grid.RowSpan="2" BorderBrush="#344D6883" BorderThickness="0,1,0,1"/><Border BorderBrush="#214D6883" BorderThickness="0,0,0,1"/></Grid>
        <Canvas x:Name="TokenChart" Height="64" Background="Transparent" ClipToBounds="True" ToolTip="当前进程累计 Token 减去区间起点累计 Token；不把每秒快照相加，非云端用量。"/>
       </Grid>
      </Grid>
      <Grid Margin="29,3,0,0"><TextBlock Text="−120 秒" FontSize="8" Foreground="#7891AD"/><TextBlock Text="现在" FontSize="8" Foreground="#7891AD" HorizontalAlignment="Right"/></Grid>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Background="#302B4159" BorderBrush="#2F506C86" BorderThickness="1" CornerRadius="9" Padding="8,6">
     <StackPanel>
      <TextBlock x:Name="RateChartTitle" Text="近 120 秒本地命中率" FontSize="10" Foreground="#CAD9EC" Margin="0,0,0,3"/>
      <TextBlock x:Name="WindowRateValue" Text="等待起点" FontSize="15" Foreground="#7CE3C7" Margin="0,0,0,4"/>
      <TextBlock x:Name="WindowRateCounts" Text="分词输入项：等待基线" FontSize="9" Foreground="#A6B7CA" TextWrapping="Wrap" Margin="0,0,0,4" ToolTip="命中分词输入项 / 成功分词输入项；不是 Token 数，也不是 API 请求数。"/>
      <Grid Height="64"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid x:Name="RateAxis"><TextBlock x:Name="RateScale" Text="100%" FontSize="9" Foreground="#88A2C0" VerticalAlignment="Top"/><TextBlock Text="0%" FontSize="9" Foreground="#88A2C0" VerticalAlignment="Bottom"/></Grid>
       <Grid Grid.Column="1" ClipToBounds="True">
        <Grid IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Grid.RowSpan="2" BorderBrush="#344D6883" BorderThickness="0,1,0,1"/><Border BorderBrush="#214D6883" BorderThickness="0,0,0,1"/></Grid>
        <Canvas x:Name="RateChart" Height="64" Background="Transparent" ClipToBounds="True" ToolTip="区间内命中输入项增量 ÷ 成功输入项增量；没有新增输入时不计算百分比。"/>
       </Grid>
      </Grid>
      <Grid Margin="29,3,0,0"><TextBlock Text="−120 秒" FontSize="8" Foreground="#7891AD"/><TextBlock Text="现在" FontSize="8" Foreground="#7891AD" HorizontalAlignment="Right"/></Grid>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChartWindowLabel" Text="近 120 秒 · 等待观察区间" FontSize="9" Foreground="#8FA6C2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ChartState" Grid.Column="1" Text="等待基线" FontSize="9" Foreground="#E8BD74" Margin="8,0,0,0" ToolTip="最多近120秒，按快照边界作差；缺值不补零。"/></Grid>
   <TextBlock x:Name="ChartOrigin" Text="起点：打开 / 切换后首个有效快照" FontSize="9" Foreground="#8FA6C2" Margin="0,3,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="ChartSource" Text="监控 UI 0.1.1-ui.9 候选 · 未安装" FontSize="9" Foreground="#8FA6C2" Margin="0,3,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
   <TextBlock Text="快照作差，不逐秒相加；切换 PID 清空并重新计数" FontSize="9" Foreground="#8FA6C2" Margin="0,0,0,3"/>
   <TextBlock Text="缺快照时不显示旧值；同一来源恢复保留有效区间；切换或硬失效重新起算" FontSize="9" Foreground="#8FA6C2" Margin="0,0,0,5" TextWrapping="Wrap"/>
   <TextBlock x:Name="CacheName" Text="本地缓存：分词计数 / 偏移结果缓存（内存）" Foreground="#A6B7CA" FontSize="10" Margin="0,0,0,5"/>
   <Expander x:Name="GpuDetails" Header="GPU · 通用启动配置（默认关闭）" IsExpanded="False" Foreground="#E5EDF7" FontSize="12" Margin="0,3,0,5">
    <StackPanel>
     <TextBlock x:Name="GpuSourceMode" Text="来源启动模式：未测量" FontSize="10" Foreground="#A6B7CA" TextWrapping="Wrap" Margin="0,5"/>
     <TextBlock Text="实际 GPU 执行：未验证。此开关仅用于本地材料排序，分词计数缓存仍走 CPU。" FontSize="10" Foreground="#A6B7CA" TextWrapping="Wrap"/>
     <CheckBox x:Name="GpuEnabled" Content="下次启动使用 CUDA（仅候选配置，当前进程不切换）" IsChecked="False" Foreground="#E5EDF7" FontSize="10" Margin="0,8"/>
     <TextBlock Text="本地 Python .exe 的绝对路径" FontSize="10" Foreground="#A6B7CA"/>
     <TextBox x:Name="GpuPythonPath" FontSize="11" MaxLength="2048" Margin="0,3,0,5" ToolTip="仅校验本地文件路径；保存不会执行 Python 或安装依赖。"/>
     <TextBlock Text="本地编码模型目录的绝对路径" FontSize="10" Foreground="#A6B7CA"/>
     <TextBox x:Name="GpuModelPath" FontSize="11" MaxLength="2048" Margin="0,3,0,5" ToolTip="必须已存在；不自动下载模型，不加载 CUDA。"/>
     <StackPanel Orientation="Horizontal"><Button x:Name="SaveGpuButton" Content="保存本配置（未接宿主）" Height="28" Padding="9,2" Margin="0,2,6,3" Background="#29445F" Foreground="#E5EDF7" BorderBrush="#567493"/><Button x:Name="ReloadGpuButton" Content="撤销未保存更改" Height="28" Padding="9,2" Margin="0,2,0,3" Background="#29445F" Foreground="#E5EDF7" BorderBrush="#567493"/></StackPanel>
     <TextBlock x:Name="GpuSaveState" Text="配置尚未读取 · 当前插件保持原启动模式" FontSize="10" Foreground="#E8BD74" TextWrapping="Wrap" Margin="0,3"/>
     <TextBlock x:Name="GpuConfigPath" Text="配置位置：尚未读取" FontSize="9" Foreground="#92A6BF" TextWrapping="Wrap"/>
     <TextBlock Text="默认按当前用户保存完整启动配置；只有显式 portable 模式才写程序目录，不回退共享位置。关闭只改 device，保留已验证的分词器/缓存/会话等设置。不自动读取或导入宿主文件，当前PID不切换；不控制API或云端KV。" FontSize="9" Foreground="#92A6BF" TextWrapping="Wrap" Margin="0,4"/>
    </StackPanel>
   </Expander>
   <Expander x:Name="ApiDetails" Header="API · 独立作用域监控" IsExpanded="True" Foreground="#E5EDF7" FontSize="12" Margin="0,3,0,5">
    <StackPanel>
     <TextBlock x:Name="ApiConnection" Text="API：等待连接 · GPU 关闭" Foreground="#E8BD74" FontSize="10" Margin="0,5" TextWrapping="Wrap"/>
     <Button x:Name="BindApiButton" Content="绑定 API…" Height="29" HorizontalAlignment="Left" Padding="12,2" Margin="0,1,0,5" Background="#29445F" Foreground="#E5EDF7" BorderBrush="#567493" ToolTip="由你点击后打开本机绑定框。Key 仅在本机原生窗口输入，不传入聊天、按钮参数或图表。"/>
     <ComboBox x:Name="ApiInstances" FontSize="10" Height="25" Margin="0,2,0,5" ToolTip="固定 PID + profile + scope；不会自动替换成其他进程。切换后只接受新收到的帧。"/>
     <TextBlock Text="近 120 秒 Token/命中率（API 独立计数）" FontSize="11" Foreground="#CAD9EC" Margin="0,3"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="已知输入 Token · 接口报告" FontSize="9" Foreground="#A6B7CA"/><TextBlock x:Name="ApiTokenValue" Text="未测量" Foreground="#91C1FF" FontSize="17"/><Canvas x:Name="ApiTokenChart" Height="54" Width="175" Background="#172A3C" ClipToBounds="True"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="缓存读取 ÷ 同记录输入" FontSize="9" Foreground="#A6B7CA"/><TextBlock x:Name="ApiRateValue" Text="未测量" Foreground="#7CE3C7" FontSize="17"/><Canvas x:Name="ApiRateChart" Height="54" Width="175" Background="#172A3C" ClipToBounds="True"/></StackPanel>
     </Grid>
     <TextBlock x:Name="ApiChartState" Text="等待新帧建立基线" Foreground="#E8BD74" FontSize="9" Margin="0,5,0,2" TextWrapping="Wrap"/>
     <TextBlock x:Name="ApiStats" Text="作用域累计请求 / 输入 / 输出 / 缓存读写：未测量" FontSize="10" Foreground="#A6B7CA" TextWrapping="Wrap" Margin="0,2"/>
     <TextBlock x:Name="ApiScope" Text="作用域：未选择" FontSize="9" Foreground="#92A6BF" TextWrapping="Wrap"/>
     <TextBlock Text="来源为接口返回的 usage，非原厂认证；不代表插件增益、费用节省或宿主全部流量。缺缓存字段时未测量。" FontSize="9" Foreground="#92A6BF" TextWrapping="Wrap" Margin="0,3"/>
     <TextBlock Text="账户/租户/实际模型身份未核实；作用域仅为配置隔离标识。" FontSize="9" Foreground="#92A6BF" TextWrapping="Wrap"/>
     <TextBlock Text="新序号快照作差，不逐秒累加；首帧只建基线，切换 PID/作用域及断线恢复重新起算。" FontSize="9" Foreground="#92A6BF" TextWrapping="Wrap"/>
    </StackPanel>
   </Expander>
   <StackPanel x:Name="DetailsScroller">
   <StackPanel x:Name="DetailsPanel">
    <ComboBox x:Name="Instances" FontSize="11" Height="25" Margin="0,5" ToolTip="选择真实插件进程；统计不跨 PID 合并"/>
    <TextBlock x:Name="Formula" Text="分母：分词输入项，非请求数 / 云端 Token" FontSize="10" Foreground="#A6B7CA" TextWrapping="Wrap" Margin="0,5"/>
    <TextBlock x:Name="Counts" Text="命中 — · 新文本计算 —" FontSize="11" TextWrapping="Wrap" Margin="0,3"/>
    <TextBlock x:Name="TotalTokens" Text="累计本地计数：未测量" FontSize="11" Margin="0,3"/>
    <TextBlock Text="仅插件处理文本；非聊天生成速度、云端用量或账单。" FontSize="10" Foreground="#92A6BF" TextWrapping="Wrap" Margin="0,3,0,7"/>
    <TextBlock x:Name="Work" Text="执行 — · 排队 — · 失败 —" FontSize="11" Margin="0,3"/>
    <TextBlock x:Name="Device" Text="GPU：等待数据" FontSize="11" Margin="0,3,0,9"/>
    <Expander x:Name="CloudDetails" Header="宿主聊天用量（尚未接入）" IsExpanded="False" Foreground="#E5EDF7" FontSize="12">
     <Border Background="#302B4159" CornerRadius="8" Padding="10" Margin="0,7"><StackPanel>
      <TextBlock x:Name="CloudRate" Text="命中率：未测量" Foreground="#E8BD74" FontSize="12"/>
      <TextBlock Text="缓存读取 Token：未测量" FontSize="11" Margin="0,5,0,0"/>
      <TextBlock Text="缓存写入 Token：未测量（不计入命中）" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="输入 / 输出 Token：未测量" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="同源输入分母 / 覆盖率：未接入" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="来源：未连接宿主 / 厂商 usage" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="费用节省 / 插件增益：未测量" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="云端口径：缓存读取 Token ÷ 同记录输入 Token。缺字段不填 0，不用本地估算替代。" FontSize="10" Foreground="#92A6BF" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel></Border>
    </Expander>
    <Grid Height="28" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="透明度" VerticalAlignment="Center" FontSize="11" Foreground="#A6B7CA"/><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.45" Maximum="1" Value="0.92" VerticalAlignment="Center"/><TextBlock x:Name="OpacityLabel" Grid.Column="2" Text="92%" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
   </StackPanel>
   </StackPanel>
   <TextBlock x:Name="Updated" Text="尚无有效快照" FontSize="10" Foreground="#92A6BF" Margin="0,7,0,0"/>
  </StackPanel>
  </ScrollViewer>
 </Border>
</Window>
